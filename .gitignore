# ==============================================================================
# KisanQ Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging
.env.production
*.env
*.env.*
!.env.example
!.env.template

# Private keys, certificates, service account tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.cer
id_rsa*
id_ed25519*
*service-account*.json
*firebase-adminsdk*.json
*credentials*.json
secrets/

# ------------------------------------------------------------------------------
# 2. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ------------------------------------------------------------------------------
# 3. Next.js & Build Outputs
# ------------------------------------------------------------------------------
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/
.turbo/
**/.turbo/
*.tsbuildinfo
next-env.d.ts.bak

# ------------------------------------------------------------------------------
# 4. Logs & Diagnostics
# ------------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. Testing & Code Coverage
# ------------------------------------------------------------------------------
coverage/
**/coverage/
.nyc_output/
test-results/
**/test-results/
playwright-report/
**/playwright-report/
blob-report/
playwright/.cache/
.last-run.json

# ------------------------------------------------------------------------------
# 6. Database Dumps & Local Databases
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.sql.dump
*.dump
*.backup
*.bak

# Supabase CLI local data & cache
.supabase/
supabase/.temp/
supabase/.branches/

# ------------------------------------------------------------------------------
# 7. Deployment Platforms
# ------------------------------------------------------------------------------
.vercel
**/.vercel/
.serverless/

# ------------------------------------------------------------------------------
# 8. Operating System & IDE Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini

# IDEs and Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.cursor/

# Temporary files & Scratch
*.tmp
*.temp
scratch/
