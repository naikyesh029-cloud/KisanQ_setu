# KisanQ Environment Configuration Template
# Copy this file to .env.local and provide your own project credentials.
# Never commit .env.local or expose service-role/cron secrets to the client.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
CRON_SECRET=replace-with-a-long-random-secret-at-least-32-chars
NEXT_PUBLIC_APP_URL=http://localhost:3000
